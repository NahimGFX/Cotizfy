{
  "name": "cotizfy",
  "version": "1.0.2",
  "description": "Aplicación de escritorio para importar, analizar y comparar matrices de precios y presupuestos",
  "author": "Nahim <nahim@cotizfy.com>",
  "main": "dist-electron/main/index.js",
  "type": "commonjs",
  "scripts": {
    "predev": "npm run build:electron",
    "dev": "concurrently -k -r \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "preview:electron": "npm run build && cross-env NODE_ENV=production electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "test:excel-import": "node scripts/test-excel-import.mjs",
    "test:price-comparison": "node scripts/test-price-comparison.mjs",
    "test": "npm run test:excel-import && npm run test:price-comparison",
    "build:renderer": "tsc --noEmit && vite build",
    "build:electron": "tsup electron/main/index.ts electron/preload/index.ts --format cjs --out-dir dist-electron --external electron --external @prisma/client",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "recharts": "^2.15.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "prettier": "3.9.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.6",
    "wait-on": "^8.0.1"
  }
}
