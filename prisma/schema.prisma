// Prisma schema for Cotizfy (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String       @id @default(uuid())
  name        String
  description String?
  client      String?
  currency    String       @default("USD")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  suppliers   Supplier[]
  items       BudgetItem[]
}

model Supplier {
  id          String      @id @default(uuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  contact     String?
  email       String?
  phone       String?
  color       String?
  orderIndex  Int         @default(0)
  quotes      ItemQuote[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
}

model BudgetItem {
  id          String      @id @default(uuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemNumber  String
  description String
  quantity    Float
  unit        String
  orderIndex  Int         @default(0)
  quotes      ItemQuote[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
}

model ItemQuote {
  id          String      @id @default(uuid())
  itemId      String
  budgetItem  BudgetItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  unitPrice   Float       @default(0)
  totalPrice  Float       @default(0)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([itemId, supplierId])
  @@index([itemId])
  @@index([supplierId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
